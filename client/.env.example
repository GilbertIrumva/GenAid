# Client Environment Configuration
# Copy this file to .env for local development or set these in your hosting environment (Vercel / Netlify)

# Base URL for local or serverless API requests
VITE_API_URL=/api

# Sanity Studio Project Credentials
VITE_SANITY_PROJECT_ID=fr1v7hol
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01

# Sanity API Token (Required for serverless placement request submissions in production)
# Generate a token with Editor/Write permissions in https://www.sanity.io/manage
SANITY_API_TOKEN=your_sanity_write_token_here
